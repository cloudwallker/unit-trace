{
  "schemaVersion": 1,
  "profile": "unit-trace-scalar-v1",
  "title": "Small-angle ideal pendulum gravity estimate",
  "variables": [
    {
      "id": "length",
      "label": "length",
      "value": "1",
      "unit": "m"
    },
    {
      "id": "period",
      "label": "period",
      "value": "2",
      "unit": "s"
    },
    {
      "id": "pi",
      "label": "pi",
